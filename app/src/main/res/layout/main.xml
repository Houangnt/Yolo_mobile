<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:id="@+id/parentView">
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/buttonSwitchCamera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SwitchCamera"/>
        <Button android:id="@+id/buttonGetCorners" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GetCorners"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
    </LinearLayout>
    <SurfaceView android:id="@+id/cameraview" android:layout_width="fill_parent" android:layout_height="fill_parent"/>
</LinearLayout>